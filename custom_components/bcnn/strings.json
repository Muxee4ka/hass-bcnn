{
  "title": "Center SBK",
  "config": {
    "abort": {
      "already_configured": "Account is already configured",
      "all_accounts_configured": "All accounts for this login are already configured in Home Assistant.",
      "reauth_successful": "Re-authentication was successful"
    },
    "error": {
      "cannot_connect": "Failed to connect",
      "invalid_auth": "Invalid login or password",
      "unknown": "Unexpected error",
      "no_accounts": "No accounts found for this login"
    },
    "step": {
      "user": {
        "title": "Center SBK account credentials",
        "description": "All accounts linked to this login will be added automatically.",
        "data": {
          "login": "Email or account number",
          "password": "Password"
        }
      },
      "reauth": {
        "title": "Update password",
        "description": "Enter the new password for account {login}.",
        "data": {
          "password": "Password"
        }
      }
    }
  },
  "entity": {
    "sensor": {
      "account": {
        "name": "Account"
      },
      "cost": {
        "name": "Amount to be paid"
      },
      "cost_date": {
        "name": "Account Date"
      },
      "balance": {
        "name": "Balance"
      },
      "opening_balance": {
        "name": "Opening balance"
      },
      "accrued": {
        "name": "Accrued"
      },
      "paid": {
        "name": "Paid"
      },
      "meter": {
        "name": "Meter"
      },
      "verification_date": {
        "name": "Verification due"
      },
      "current_timestamp": {
        "name": "Last update"
      }
    },
    "binary_sensor": {
      "has_debt": {
        "name": "Has debt"
      }
    },
    "button": {
      "refresh": {
        "name": "Refresh"
      },
      "get_bill": {
        "name": "Get bill"
      },
      "send_readings": {
        "name": "Send readings"
      }
    }
  },
  "services": {
    "refresh": {
      "name": "Refresh",
      "description": "Refresh Center-SBK account data.",
      "fields": {
        "device_id": {
          "name": "Account",
          "description": "Center-SBK device to refresh."
        }
      }
    },
    "get_bill": {
      "name": "Get bill",
      "description": "Download the current bill PDF from Center-SBK.",
      "fields": {
        "device_id": {
          "name": "Account",
          "description": "Center-SBK device."
        }
      }
    },
    "send_readings": {
      "name": "Send readings",
      "description": "Submit water meter readings to Center-SBK. Selected meters must belong to the chosen account, otherwise the service will return an error. If neither meter slots nor the 'Readings' field are filled, values are taken from the meter number entities of this account.",
      "fields": {
        "device_id": {
          "name": "Account",
          "description": "Center-SBK device."
        },
        "meter_1": {
          "name": "Meter 1",
          "description": "Meter sensor of this account."
        },
        "meter_1_value": {
          "name": "Meter 1 reading, m³",
          "description": "New reading value."
        },
        "meter_2": {
          "name": "Meter 2",
          "description": "Meter sensor of this account."
        },
        "meter_2_value": {
          "name": "Meter 2 reading, m³",
          "description": "New reading value."
        },
        "meter_3": {
          "name": "Meter 3",
          "description": "Meter sensor of this account."
        },
        "meter_3_value": {
          "name": "Meter 3 reading, m³",
          "description": "New reading value."
        },
        "meter_4": {
          "name": "Meter 4",
          "description": "Meter sensor of this account."
        },
        "meter_4_value": {
          "name": "Meter 4 reading, m³",
          "description": "New reading value."
        },
        "readings": {
          "name": "Readings (for automations)",
          "description": "Alternative to the meter slots — a mapping 'meter number → reading (m³)'. Convenient for automations that pull values from other integrations. Jinja templates are supported (see README for examples)."
        }
      }
    }
  },
  "issues": {
    "parse_error": {
      "title": "Center-SBK: cabinet page structure changed",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "Acknowledge",
            "description": "The integration could not scrape the cabinet for account {account}. The site's HTML may have changed. Please open an issue at the project tracker with the error detail below so a fix can be released.\n\nDetail: {detail}\n\nClick submit to dismiss this notification. It will reappear if the next refresh hits the same error."
          }
        }
      }
    }
  }
}
